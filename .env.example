# Database Configuration (MySQL)
DATABASE_URL="mysql://user:password@host:port/database_name"

# JWT Secret for Authentication
JWT_SECRET="your-secure-random-string-min-32-characters"

# ============================================
# CLOUDFLARE R2 CONFIGURATION
# ============================================
# Get these from Cloudflare Dashboard > R2 > API Tokens

# Your Cloudflare Account ID
CLOUDFLARE_ACCOUNT_ID="xxxx"

# R2 Access Key ID
CLOUDFLARE_ACCESS_KEY_ID="xxxx"

# R2 Secret Access Key
CLOUDFLARE_SECRET_ACCESS_KEY="xxxx"

# R2 Bucket Name
CLOUDFLARE_R2_BUCKET_NAME="insightonix-files"

# R2 Endpoint (Usually: https://{ACCOUNT_ID}.r2.cloudflarestorage.com)
CLOUDFLARE_R2_ENDPOINT="https://xxxx.r2.cloudflarestorage.com"

# R2 Public URL (Custom domain or r2.dev subdomain)
# Format: https://pub-xxx.r2.dev or https://files.yourdomain.com
CLOUDFLARE_R2_PUBLIC_URL="https://pub-xxxx.r2.dev"
