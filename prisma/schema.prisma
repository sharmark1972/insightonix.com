generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Journal {
  id            Int      @id @default(autoincrement())
  title         String
  issn          String?  @unique
  eissn         String?  @unique
  description   String?  @db.Text
  contact_email String?  @map("contact_email")
  contact_phone String?  @map("contact_phone")
  address       String?  @db.Text
  institution   String?
  doi_prefix    String?  @map("doi_prefix")
  doi_suffix    Int      @default(1) @map("doi_suffix")
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@map("journals")
}

model Issue {
  id               Int       @id @default(autoincrement())
  volume           Int
  issue_number     Int       @map("issue_number")
  title            String?
  publication_date DateTime? @db.Date @map("publication_date")
  cover_image      String?   @map("cover_image")
  description      String?   @db.Text
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt
  articles         Article[]

  @@unique([volume, issue_number])
  @@map("issues")
}

model Article {
  id              Int             @id @default(autoincrement())
  issue_id        Int
  issue           Issue           @relation(fields: [issue_id], references: [id], onDelete: Cascade)
  title           String          @db.VarChar(500)
  abstract        String?         @db.Text
  keywords        String?         @db.Text
  doi             String?         @unique
  pdf_url         String?         @map("pdf_url")
  page_start      Int?            @map("page_start")
  page_end        Int?            @map("page_end")
  submission_date DateTime?       @db.Date @map("submission_date")
  acceptance_date DateTime?       @db.Date @map("acceptance_date")
  created_at      DateTime        @default(now())
  updated_at      DateTime        @updatedAt
  authors         ArticleAuthor[]
  awards          Award[]        @relation("ArticleAwards")

  @@index([issue_id])
  @@index([doi])
  @@map("articles")
}

model Author {
  id          Int             @id @default(autoincrement())
  name        String
  email       String?
  affiliation String?         @db.VarChar(500)
  orcid       String?
  created_at  DateTime        @default(now())
  articles    ArticleAuthor[]
  awards      Award[]        @relation("AuthorAwards")

  @@index([name])
  @@map("authors")
}

model ArticleAuthor {
  article_id       Int
  author_id        Int
  article          Article @relation(fields: [article_id], references: [id], onDelete: Cascade)
  author           Author  @relation(fields: [author_id], references: [id], onDelete: Cascade)
  order_index      Int     @default(0)
  is_corresponding Boolean @default(false)

  @@id([article_id, author_id])
  @@index([article_id])
  @@index([author_id])
  @@map("article_authors")
}

model BoardMember {
  id            Int      @id @default(autoincrement())
  name          String
  title         String?
  affiliation   String?  @db.VarChar(500)
  email         String?
  profile_image String?  @map("profile_image")
  role          String?
  display_order Int      @default(0)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@index([display_order])
  @@map("board_members")
}

model Admin {
  id            Int       @id @default(autoincrement())
  username      String    @unique
  password_hash String
  email         String?   @unique
  last_login    DateTime? @map("last_login")
  created_at    DateTime  @default(now())

  @@index([username])
  @@map("admins")
}

model Conference {
  id              Int              @id @default(autoincrement())
  name            String
  description     String?          @db.Text
  venue           String?
  date            DateTime?        @db.Date
  conference_year Int              @map("conference_year")
  created_at      DateTime         @default(now())
  updated_at      DateTime         @updatedAt
  certificates    Certificate[]

  @@unique([name, conference_year])
  @@index([conference_year])
  @@map("conferences")
}

model Certificate {
  id             Int       @id @default(autoincrement())
  type           String
  recipient_name String
  recipient_email String?
  conference_id  Int       @map("conference_id")
  conference     Conference @relation(fields: [conference_id], references: [id], onDelete: Cascade)
  certificate_url String?
  format         String?
  issue_date     DateTime  @default(now())
  created_at     DateTime  @default(now())

  @@index([type])
  @@index([conference_id])
  @@map("certificates")
}

model AwardCategory {
  id          Int      @id @default(autoincrement())
  name        String
  description String?  @db.Text
  award_type  String
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  awards      Award[]

  @@index([award_type])
  @@map("award_categories")
}

model Award {
  id            Int          @id @default(autoincrement())
  category_id   Int          @map("category_id")
  category      AwardCategory @relation(fields: [category_id], references: [id], onDelete: Cascade)
  article_id    Int?         @map("article_id")
  article       Article?     @relation("ArticleAwards", fields: [article_id], references: [id])
  author_id     Int?         @map("author_id")
  author        Author?      @relation("AuthorAwards", fields: [author_id], references: [id])
  award_year    Int          @map("award_year")
  award_date    DateTime?    @db.Date @map("award_date")
  certificate_url String?   @map("certificate_url")
  created_at    DateTime     @default(now())

  @@unique([category_id, article_id, award_year])
  @@unique([category_id, author_id, award_year])
  @@index([award_year])
  @@index([category_id])
  @@map("awards")
}

model EditorialCertificate {
  id              Int      @id @default(autoincrement())
  recipient_name  String
  recipient_email String?
  role            String
  year            Int
  certificate_url String?
  issue_date      DateTime @default(now())
  created_at      DateTime @default(now())

  @@index([year])
  @@map("editorial_certificates")
}

model ReviewerCertificate {
  id              Int      @id @default(autoincrement())
  recipient_name  String
  recipient_email String?
  articles_reviewed Int    @default(0) @map("articles_reviewed")
  year            Int
  certificate_url String?
  issue_date      DateTime @default(now())
  created_at      DateTime @default(now())

  @@index([year])
  @@map("reviewer_certificates")
}

model Ebook {
  id            Int      @id @default(autoincrement())
  title         String   @db.VarChar(500)
  isbn          String?  @unique
  author        String?
  publisher     String?
  published_year Int?    @map("published_year")
  description   String?  @db.Text
  cover_image   String?  @map("cover_image")
  pdf_url       String?  @map("pdf_url")
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@index([title])
  @@map("ebooks")
}
